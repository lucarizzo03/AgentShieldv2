# Backend API base, including the /v1 suffix.
# Local: http://localhost:8000/v1 — deployed: https://<api-host>/v1
VITE_API_BASE_URL=http://localhost:8000/v1

# Cognito. Values come from `terraform output` after apply. VITE_COGNITO_REGION
# enables the in-app email/password sign-in (USER_PASSWORD_AUTH); without it
# the dashboard falls back to redirecting to the hosted UI at VITE_COGNITO_DOMAIN.
VITE_COGNITO_REGION=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=

# Optional: default to <origin>/auth/callback and <origin>/ respectively.
# Must match the callback/logout URLs Terraform registers from `dashboard_origin`.
VITE_COGNITO_REDIRECT_URI=
VITE_COGNITO_LOGOUT_URI=
VITE_COGNITO_SCOPES=openid profile email

# Local-only escape hatch: skips the Cognito redirect and sends a static bearer token.
VITE_ENABLE_DEV_AUTH=false
VITE_DEV_USER_TOKEN=
